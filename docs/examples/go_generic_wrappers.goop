// Concrete @[go] wrappers for generic Go APIs (GOSIG004). No std.slices.
module main

@[go] {
  import "slices"

  func stringsContains(hay []string, needle string) bool {
    return slices.Contains(hay, needle)
  }
}
val stringsContains : string go_slice -> string -> bool

let main () =
  begin
    let xs = go_slice_of_list ["eth"; "btc"; "sol"] in
    if stringsContains xs "btc" then println "btc" else println "missing"
  end
