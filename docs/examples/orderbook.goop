module Trading.OrderBook

(* Prices as integer cents — avoid float money (DECIMAL001).
 * Prefer std.decimal.Decimal in apps; see docs/design/25-decimal.md. *)

type order_id = | Order_id of string
type symbol = | Symbol of string

type Side = Buy | Sell

type Order =
  { id: order_id
  ; symbol: symbol
  ; side: Side
  ; price_cents: int where price_cents > 0
  ; qty: int where qty > 0
  }

type Fill =
  { buyOrder: order_id
  ; sellOrder: order_id
  ; price_cents: int
  ; qty: int where qty > 0
  }

type Book =
  { bids: Order list
  ; asks: Order list
  }

let emptyBook : Book = { bids = []; asks = [] }

let isBetter (side: Side) (a: int) (b: int) : bool =
  match side with
  | Buy -> a > b
  | Sell -> a < b

let rec insertBy (greater: int -> int -> bool) (o: Order) (orders: Order list) : Order list =
  match orders with
  | [] -> [o]
  | first :: rest ->
      if greater o.price_cents first.price_cents then o :: orders
      else first :: insertBy greater o rest

let addOrder (bk: Book) (o: Order) : Book =
  match o.side with
  | Buy -> { bids = insertBy (isBetter Buy) o bk.bids; asks = bk.asks }
  | Sell -> { bids = bk.bids; asks = insertBy (isBetter Sell) o bk.asks }

let bestBid (bk: Book) : int option =
  match bk.bids with
  | [] -> None
  | b :: _ -> Some b.price_cents
