module Trading.AllMidsBot

(* Mid as integer cents — intentional for simple thresholds.
 * Prefer std.decimal.Decimal for money values; see docs/examples/decimal_money.goop.
 * DECIMAL001 still warns on float money names. *)

type symbol = | Symbol of string

let midPriceCents (sym: symbol) : int =
  10000

let decide (px_cents: int) : string =
  if px_cents > 10000 then "sell" else "buy"

let main () : unit =
  let sym = Symbol "BTC-USD" in
  let px = midPriceCents sym in
  println (decide px)
