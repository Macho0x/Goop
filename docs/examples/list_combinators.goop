// Prelude List.filter / map / fold (Go generics) — `goop build`s.
module main

let main () =
  let xs = 1 :: 2 :: 3 :: 4 :: [] in
  let evens = List.filter (fun n -> n mod 2 = 0) xs in
  let doubled = List.map (fun n -> n * 2) xs in
  let sum = List.fold (fun acc n -> acc + n) 0 xs in
  let evens2 = xs.filter (fun n -> n mod 2 = 0) in
  let _ = List.find (fun n -> n > 2) xs in
  let _ = evens in
  let _ = doubled in
  let _ = evens2 in
  println (int_to_string sum)
