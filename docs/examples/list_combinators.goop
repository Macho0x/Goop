// std.list Map / Filter / Fold — goop check only (polymorphic lowering is interface{}).
module main

import goop . "std.list"

let main () =
  let xs = 1 :: 2 :: 3 :: 4 :: [] in
  let _ = Map (fun x -> x) xs in
  let _ = Filter (fun n -> n mod 2 = 0) xs in
  let _ = Fold (fun acc n -> acc + n) 0 xs in
  println "ok"
