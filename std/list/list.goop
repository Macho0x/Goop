module list

let rec Map (f: 'a -> 'b) (xs: 'a list) : 'b list =
  match xs with
  | [] -> []
  | x :: rest -> f x :: Map f rest

let rec Filter (f: 'a -> bool) (xs: 'a list) : 'a list =
  match xs with
  | [] -> []
  | x :: rest -> if f x then x :: Filter f rest else Filter f rest

let rec Fold (f: 'acc -> 'a -> 'acc) (acc: 'acc) (xs: 'a list) : 'acc =
  match xs with
  | [] -> acc
  | x :: rest -> Fold f (f acc x) rest
