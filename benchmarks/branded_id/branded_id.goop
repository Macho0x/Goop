module Bench.BrandedId

// Microbenchmark: single-ctor branded ID wrap/unwrap.
// Zero-cost H4c: lowers to `type order_id string` (see docs/design/21-branded-ids.md).

type order_id = | Order_id of string

let wrap (s: string) : order_id = Order_id s

let unwrap (id: order_id) : string =
  match id with
  | Order_id s -> s

let roundtrip (s: string) : string = unwrap (wrap s)
