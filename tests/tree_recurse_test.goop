module TreeRecurseTest

// Simple binary-tree ADT: structural checks without nested `Node of tree * …`
// (that shape hits TYPE010 / bad match codegen — see tree_fold_test.goop).

type tree =
  | Leaf
  | Node of int

let depth_hint (t: tree) : int =
  match t with
  | Leaf -> 0
  | Node _ -> 1

let double_payload (t: tree) : int =
  match t with
  | Leaf -> 0
  | Node n -> n * 2

let main () =
  begin
    assert (depth_hint Leaf = 0);
    assert (depth_hint (Node 5) = 1);
    assert (double_payload (Node 21) = 42);
    assert (double_payload Leaf = 0)
  end
