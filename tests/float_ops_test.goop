module FloatOpsTest

// Float arithmetic, chained comparisons, string rendering.

let main () =
  begin
    assert (1.5 +. 2.25 = 3.75);
    assert (10.0 -. 2.5 = 7.5);
    assert (3.0 *. 4.0 = 12.0);
    assert (7.5 /. 2.5 = 3.0);
    assert (2.5 > 2.0 && 2.0 >= 2.0 && 1.5 < 2.0 && 1.5 <= 1.5);
    assert (2.5 <> 1.5);
    assert (float_to_string 2.5 = "2.5");
    assert (float_to_string 0.5 = "0.5");
    assert (0.5 *. 2.0 = 1.0);
    assert (3.14 > 3.0)
  end
