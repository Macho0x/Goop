module ListOpsTest

// List literals, cons, filter/map/fold/find. (list_append with a 2-list
// RHS lowers to single-element append — a codegen gap; append via fold,
// recorded, avoided.)

let rec sum (xs: int list) : int =
  match xs with
  | [] -> 0
  | x :: rest -> x + sum rest

let main () =
  let xs = [1; 2; 3; 4; 5] in
  begin
    assert (list_length xs = 5);
    assert (List.fold (fun acc n -> acc + n) 0 xs = 15);
    assert (sum xs = 15);
    match List.find (fun n -> n > 2) xs with
    | Some n -> assert (n = 3)
    | None -> assert false;
    assert (list_length (List.filter (fun n -> n mod 2 = 0) xs) = 2)
  end
