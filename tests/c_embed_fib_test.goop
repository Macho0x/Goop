module CEmbedFibTest

// Inline C via @[c]: recursive fib + gcd at the cgo boundary.

@[c] {
  int c_fib(int n) {
    if (n < 2) {
      return n;
    }
    return c_fib(n - 1) + c_fib(n - 2);
  }

  int c_gcd(int a, int b) {
    if (b == 0) {
      return a;
    }
    return c_gcd(b, a % b);
  }
}
val c_fib : int -> int
val c_gcd : int -> int -> int

let main () =
  begin
    assert (c_fib 0 = 0);
    assert (c_fib 1 = 1);
    assert (c_fib 10 = 55);
    assert (c_fib 20 = 6765);
    assert (c_gcd 48 18 = 6);
    assert (c_gcd 17 5 = 1);
    assert (c_gcd (c_fib 6) (c_fib 8) = 1)
  end
