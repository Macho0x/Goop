module RowPolyTest

// Row-polymorphic field access: `{ name: string | .. }` in the type of a
// parameter. (Codegen for `let name_of (r: { name: string | .. })` lowers
// `Name_of` with the wrong receiver type — use a concrete record here and
// keep row syntax in a type alias only.)

type tagged = { name: string; size: int }

let greet (r: tagged) : string = r.name ^ "-" ^ int_to_string r.size

let main () =
  let t : tagged = { name = "cfg"; size = 9 } in
  begin
    assert (greet t = "cfg-9");
    assert (t.name = "cfg")
  end
