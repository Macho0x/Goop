module main

import goop . "std.string"
import goop . "std.chan"

(* Smoke coverage for M4 thin std.string / std.chan re-exports. *)
let main () =
  begin
    assert (length "abc" = 3);
    assert (sub "abcdef" 1 3 = "bcd");
    assert (concat "a" "b" = "ab");
    assert (of_int 7 = "7");
    let ch : int chan = make () in
    begin
      go (fun () -> send ch 1);
      assert (recv ch = 1);
      close ch
    end
  end
