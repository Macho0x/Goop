module MapOpsTest

// map[K] V coverage: add/get/mem/remove/size with string and int keys.

let main () =
  begin
    let m : map[string] int = Map.make () in
    let _ = Map.add m "btc" 1 in
    let _ = Map.add m "eth" 2 in
    assert (Map.size m = 2);
    assert (Map.mem m "btc");
    match Map.get m "eth" with
    | Some n -> assert (n = 2)
    | None -> assert false;
    let _ = Map.remove m "btc" in
    assert (not (Map.mem m "btc"));
    let counts : map[int] string = Map.make () in
    let _ = Map.add counts 1 "one" in
    match Map.get counts 1 with
    | Some s -> assert (s = "one")
    | None -> assert false
  end
