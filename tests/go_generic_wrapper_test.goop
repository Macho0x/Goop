module main

@[go] {
  import "slices"

  func stringsContains(hay []string, needle string) bool {
    return slices.Contains(hay, needle)
  }
}
val stringsContains : string go_slice -> string -> bool

let main () =
  begin
    let xs = go_slice_of_list ["a"; "b"; "c"] in
    assert (stringsContains xs "b");
    assert (not (stringsContains xs "z"))
  end
